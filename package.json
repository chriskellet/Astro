{
  "name": "astrobot-mobile",
  "version": "1.0.0",
  "description": "Mobile-optimized Astrobot clone for iPad and iPhone",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
